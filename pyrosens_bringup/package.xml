  <version>0.0.0</version>
  <description>Launch and params for PyroSENS project</description>
  <maintainer email="elijah.spannenberg@student.uts.edu.au">elijahs04</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
