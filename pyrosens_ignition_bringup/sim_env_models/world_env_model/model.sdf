<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="test">
    <!-- Make environment geometry static -->
    <static>true</static>

    <link name="testlink">
      <visual name="Plane">
        <geometry>
          <mesh>
            <!-- Prefer a meshes/ path or model://YourModel/meshes/... -->
            <uri>meshes/model.dae</uri>
            <submesh>
              <name>Plane</name>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.0 0.0 0.0 1.0</specular>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <!-- If this is heavy, consider a simplified collision mesh or primitive -->
            <uri>meshes/model.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <contact/>
        </surface>
        <collide_bitmask>1</collide_bitmask>
      </collision>
    </link>
  </model>
</sdf>

