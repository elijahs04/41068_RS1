<?xml version="1.0"?>
<package format="3">
  <name>pyrosens_integrated_sensors</name>
  <version>0.1.0</version>
  <description>Unified package combining thermal, wind, and goals nodes (sensors, interpolation, sims) plus multi-node runners for the progress demo.</description>

   <!-- Maintainers: responsible for releases and long-term upkeep -->
  <maintainer email="connor.lindsell@student.uts.edu.au">Connor Lindsell</maintainer>
  <maintainer email="james.c.farrell@student.uts.edu.au">James Farrell</maintainer>

  <!-- Authors/contributors -->
  <author email="dev1@student.uts.edu.au">Dev One</author>
  <author email="dev3@student.uts.edu.au">Dev Two</author>

  <license>LGPLv3</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS 2 -->
  <depend>rclcpp</depend>
  <!-- Core dependencies -->
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- TF (thermal nodes use tf2/tf2_ros) -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>cv_bridge</depend>
  <depend>std_srvs</depend>
  <depend>opencv</depend>

  <build_depend>eigen3_cmake_module</build_depend>
  <build_export_depend>eigen3_cmake_module</build_export_depend>
  <exec_depend>eigen3_cmake_module</exec_depend>
  <depend>Eigen3</depend>

  <!-- Tools (RViz configs, optional at runtime) -->
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
