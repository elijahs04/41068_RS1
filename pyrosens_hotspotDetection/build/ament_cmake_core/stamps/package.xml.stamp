<?xml version="1.0"?>
<package format="3">
  <name>pyrosens_hotspotDetection</name>
  <version>0.1.0</version>
  <description>Hotspot detection from thermal images (Ignition → ROS 2)</description>

  <maintainer email="connor.lindsell@student.uts.edu.au">Connor Lindsell</maintainer>
  <author email="dev1@student.uts.edu.au">Dev One</author>
  <author email="dev3@student.uts.edu.au">Dev Two</author>

  <license>LGPLv3</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core runtime deps -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>vision_msgs</depend>

  <!-- OpenCV -->
  <exec_depend>opencv</exec_depend>

  <!-- Rviz -->
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>